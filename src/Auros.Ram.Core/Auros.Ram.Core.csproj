<Project Sdk="Microsoft.NET.Sdk">
  <!-- RNF-07: dominio independiente de la interfaz. -->
  <PropertyGroup>
    <RootNamespace>Auros.Ram.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Messages.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Messages.Designer.cs</StronglyTypedFileName>
