<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Auros.Ram.App.ViewModels"
             xmlns:r="using:Auros.Ram.App.Resources"
             x:Class="Auros.Ram.App.Views.ScalesView"
             x:DataType="vm:ScalesViewModel">
  <UserControl.Styles>
    <!-- Celda del mapa de calor: conserva sus colores al pasar el mouse; se marca con un borde de tinta. -->
    <Style Selector="Button.heat">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.heat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.heat:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button ui:ButtonIcon.Icon="{StaticResource IconReassess}" Content="{x:Static r:Strings.Scales_TranslateNames}" Command="{Binding TranslateNamesCommand}"
                  ToolTip.Tip="{x:Static r:Strings.Scales_TranslateNamesTip}" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconSave}" Content="{x:Static r:Strings.Scales_SaveTemplate}" Command="{Binding SaveTemplateCommand}"
                  ToolTip.Tip="{x:Static r:Strings.Scales_SaveTemplateTip}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{x:Static r:Strings.Section_Scales}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Scales_Intro}" />
        </StackPanel>
      </DockPanel>

      <!-- Mapa de calor: el nivel de riesgo de cada combinación de impacto y probabilidad. -->
      <Border Classes="card" IsVisible="{Binding HasHeatMap}">
        <StackPanel Spacing="12">
          <DockPanel>
            <Button ui:ButtonIcon.Icon="{StaticResource IconReassess}" DockPanel.Dock="Right" Content="{x:Static r:Strings.HeatMap_Reset}" Command="{Binding ResetHeatMapCommand}"
                    IsEnabled="{Binding IsHeatMapCustom}" VerticalAlignment="Top" />
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="{x:Static r:Strings.HeatMap_Title}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.HeatMap_Intro}" />
            </StackPanel>
          </DockPanel>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto,Auto" HorizontalAlignment="Left">
            <LayoutTransformControl VerticalAlignment="Center" Margin="0,0,8,0">
              <LayoutTransformControl.LayoutTransform>
                <RotateTransform Angle="-90" />
              </LayoutTransformControl.LayoutTransform>
              <TextBlock Classes="muted" FontSize="12" Text="{x:Static r:Strings.Matrix_AxisImpact}" />
            </LayoutTransformControl>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeatRow">
                  <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Width="132" Content="{Binding Impact}" HorizontalContentAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeatCellItem">
                          <Button Classes="heat" Width="112" Height="40" Margin="2"
                                  Background="{Binding Level.Background, FallbackValue=Transparent}"
                                  Foreground="{Binding Level.Foreground, FallbackValue=Black}"
                                  ToolTip.Tip="{Binding Tooltip}">
                            <TextBlock Text="{Binding Level.Name, FallbackValue=''}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" />
                            <Button.Flyout>
                              <MenuFlyout ItemsSource="{Binding Options}">
                                <MenuFlyout.ItemContainerTheme>
                                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:HeatOption">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                    <Setter Property="FontWeight" Value="{Binding IsCurrent, Converter={x:Static vm:Converters.BoldIf}}" />
                                  </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HeatColumns}" Margin="140,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LevelChip">
                  <ContentControl Width="112" Margin="2,0" Content="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="140,6,0,0" Text="{x:Static r:Strings.Matrix_AxisProbability}" />
          </Grid>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScaleGroup">
            <Border Classes="card" Margin="0,0,0,16">
              <StackPanel Spacing="10">
                <DockPanel>
                  <Button ui:ButtonIcon.Icon="{StaticResource IconAdd}" DockPanel.Dock="Right" Content="{x:Static r:Strings.Scales_Add}"
                          Command="{Binding $parent[UserControl].((vm:ScalesViewModel)DataContext).AddCommand}" CommandParameter="{Binding}" />
                  <StackPanel>
                    <TextBlock Classes="h2" Text="{Binding Title}" />
                    <TextBlock Classes="muted" Text="{Binding Purpose}" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Scales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScaleItem">
                      <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button ui:ButtonIcon.Icon="{StaticResource IconEdit}" Content="{x:Static r:Strings.Common_Edit}"
                                    Command="{Binding $parent[UserControl].((vm:ScalesViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                            <Button ui:ButtonIcon.Icon="{StaticResource IconDelete}" Content="{x:Static r:Strings.Common_Delete}"
                                    Command="{Binding $parent[UserControl].((vm:ScalesViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                          <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Classes="muted" Text="{Binding LevelCount}" />
                              <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding IsAssigned}" Padding="7,1">
                                <TextBlock Text="{x:Static r:Strings.Scales_Assigned}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                              </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Levels}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LevelChip">
                                  <!-- Con el rango del nivel debajo, si tiene (monto en Impacto, porcentaje en Probabilidad). -->
                                  <StackPanel Margin="0,0,8,4" Spacing="1">
                                    <ContentControl Content="{Binding}" HorizontalAlignment="Left" />
                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding RangeText}"
                                               IsVisible="{Binding RangeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
