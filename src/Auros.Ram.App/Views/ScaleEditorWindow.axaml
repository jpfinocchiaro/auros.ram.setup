<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:m="using:Auros.Ram.Core.Model"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.ScaleEditorWindow"
        x:DataType="vm:ScaleEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="1240" Height="620" MinWidth="1000" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <Window.Resources>
    <DataTemplate x:Key="NamedColorTemplate" x:DataType="m:NamedColor">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="16" Height="16" CornerRadius="2" Background="{Binding Hex}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
        <TextBlock Text="{Binding Name}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
      <Grid ColumnDefinitions="2*,16,*">
        <StackPanel>
          <TextBlock Classes="label" Text="{x:Static r:Strings.Scale_Name}" />
          <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="150" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="label" Text="{x:Static r:Strings.Scale_Type}" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" IsEnabled="{Binding IsNew}" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Scale_LevelsHint}" />
      <!-- Rangos: monto (Impacto) o porcentaje (Probabilidad) por nivel, para elegir el nivel desde el valor. -->
      <DockPanel IsVisible="{Binding HasRanges}">
        <Button ui:ButtonIcon.Icon="{StaticResource IconSplit}" DockPanel.Dock="Right" Content="{x:Static r:Strings.Scale_SplitPercent}" Command="{Binding SplitPercentCommand}"
                IsVisible="{Binding IsProbability}" Margin="12,0,0,0" />
        <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding RangeHint}" />
      </DockPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <DockPanel>
        <Button ui:ButtonIcon.Icon="{StaticResource IconAdd}" DockPanel.Dock="Left" Content="{x:Static r:Strings.Scale_AddLevel}" Command="{Binding AddLevelCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconSave}" Classes="accent" Content="{x:Static r:Strings.Common_Save}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Border Classes="card" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,236,236,130,150,150,Auto" Margin="4,0,4,6">
          <TextBlock Classes="label" Text="{x:Static r:Strings.Scale_Order}" />
          <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:Strings.Scale_LevelName}" />
          <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:Strings.Scale_Color}" />
          <TextBlock Grid.Column="3" Classes="label" Text="{x:Static r:Strings.Scale_TextColor}" />
          <TextBlock Grid.Column="4" Classes="label" Text="{x:Static r:Strings.Scale_Preview}" />
          <TextBlock Grid.Column="5" Classes="label" Text="{x:Static r:Strings.Scale_RangeFrom}" IsVisible="{Binding HasRanges}" />
          <TextBlock Grid.Column="6" Classes="label" Text="{x:Static r:Strings.Scale_RangeTo}" IsVisible="{Binding HasRanges}" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelEditViewModel">
                <Grid ColumnDefinitions="110,*,236,236,130,150,150,Auto" Margin="4,3">
                  <NumericUpDown Value="{Binding Order}" Minimum="0" Maximum="100" Increment="1" FormatString="0" Margin="0,0,6,0" />
                  <TextBox Grid.Column="1" Text="{Binding Name}" MaxLength="80" Margin="0,0,6,0" Watermark="{x:Static r:Strings.Scale_LevelNameHint}" />
                  <!-- Color de fondo: de la paleta o un código #RRGGBB -->
                  <Grid Grid.Column="2" ColumnDefinitions="*,84" Margin="0,0,6,0">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Colors}" SelectedItem="{Binding NamedColor}"
                              PlaceholderText="{x:Static r:Strings.Scale_CustomColor}" Margin="0,0,4,0" ItemTemplate="{StaticResource NamedColorTemplate}" />
                    <TextBox Grid.Column="1" Text="{Binding Hex}" MaxLength="7" ToolTip.Tip="{x:Static r:Strings.Scale_Hex}" />
                  </Grid>
                  <!-- Color de fuente -->
                  <Grid Grid.Column="3" ColumnDefinitions="*,84" Margin="0,0,6,0">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TextColors}" SelectedItem="{Binding NamedTextColor}"
                              PlaceholderText="{x:Static r:Strings.Scale_CustomColor}" Margin="0,0,4,0" ItemTemplate="{StaticResource NamedColorTemplate}" />
                    <TextBox Grid.Column="1" Text="{Binding TextHex}" MaxLength="7" ToolTip.Tip="{x:Static r:Strings.Scale_Hex}" />
                  </Grid>
                  <StackPanel Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center" Spacing="2">
                    <Border Background="{Binding Preview}" CornerRadius="2" Padding="7,3" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Name}" Foreground="{Binding PreviewText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock IsVisible="{Binding LowContrast}" FontSize="11" Foreground="{DynamicResource ErrorBrush}"
                               Text="{x:Static r:Strings.Scale_LowContrast}" ToolTip.Tip="{x:Static r:Strings.Scale_LowContrastTip}" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="5" Value="{Binding RangeFrom}" Minimum="0" Maximum="{Binding Owner.RangeMax}" Increment="1"
                                 FormatString="N2" ShowButtonSpinner="False" Margin="0,0,6,0" IsVisible="{Binding Owner.HasRanges}"
                                 Watermark="{x:Static r:Strings.Scale_RangeFrom}" />
                  <NumericUpDown Grid.Column="6" Value="{Binding RangeTo}" Minimum="0" Maximum="{Binding Owner.RangeMax}" Increment="1"
                                 FormatString="N2" ShowButtonSpinner="False" Margin="0,0,6,0" IsVisible="{Binding Owner.HasRanges}"
                                 Watermark="{x:Static r:Strings.Scale_RangeTo}" />
                  <Button Grid.Column="7" Content="✕" ToolTip.Tip="{x:Static r:Strings.Scale_RemoveLevel}"
                          Command="{Binding Owner.RemoveLevelCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
