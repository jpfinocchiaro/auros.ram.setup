<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Auros.Ram.App.ViewModels"
             xmlns:r="using:Auros.Ram.App.Resources"
             xmlns:views="using:Auros.Ram.App.Views"
             xmlns:sys="using:System"
             x:Class="Auros.Ram.App.Views.MatrixView"
             x:DataType="vm:MatrixViewModel">
  <!-- La matriz es la pieza central de la aplicación: un mapa de calor de impacto × probabilidad con ejes.
       Cada celda se pinta con el nivel de riesgo que le toca y lista sus riesgos. -->
  <UserControl.Styles>
    <Style Selector="Border.cell">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="5,4" />
    </Style>
    <!-- Riesgo dentro de una celda: el texto toma el color de fuente del nivel de la celda. -->
    <Style Selector="Button.tile">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontFamily" Value="{StaticResource CondensedFontFamily}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
  </UserControl.Styles>

  <!-- Sin desplazamiento horizontal: las columnas se reparten el ancho y los títulos largos se recortan. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <DockPanel Margin="32,24,32,20" MinWidth="760">
      <!-- Encabezado: título y proyecto a la izquierda, logo de la empresa a la derecha (RF-15) -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
        <DockPanel>
          <Image DockPanel.Dock="Right" Source="{Binding CompanyLogo}" Height="44" MaxWidth="180" Stretch="Uniform" VerticalAlignment="Center" />
          <StackPanel Spacing="2">
            <TextBlock Classes="display" Text="{x:Static r:Strings.Section_Matrix}" />
            <TextBlock Classes="muted" FontSize="14" Text="{Binding Subtitle}" />
            <!-- Evolución: la matriz a una fecha y el recorrido de un riesgo por las celdas. -->
            <WrapPanel Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,4">
                <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{x:Static r:Strings.Matrix_AsOf}" />
                <CalendarDatePicker x:Name="AsOfPicker" SelectedDate="{Binding AsOfDate}" Width="150"
                                    Watermark="{x:Static r:Strings.Matrix_Today}" DisplayDateEnd="{x:Static sys:DateTime.Today}" />
                <Button Content="{x:Static r:Strings.Matrix_Today}" Command="{Binding ShowTodayCommand}" IsVisible="{Binding IsHistorical}" />
              </StackPanel>
              <CheckBox IsChecked="{Binding Display.ShowImpactAmount}" Content="{x:Static r:Strings.Matrix_ShowAmount}"
                        Margin="0,0,24,4" ToolTip.Tip="{x:Static r:Strings.Matrix_ShowAmountTip}" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{x:Static r:Strings.Matrix_Path}" />
                <ComboBox x:Name="PathPicker" ItemsSource="{Binding PathRisks}" SelectedItem="{Binding PathRisk}" Width="280" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Pie: leyenda del nivel de riesgo y exportaciones -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static r:Strings.Matrix_ExportPdf}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="PdfMatrix" />
          <Button Content="{x:Static r:Strings.Matrix_ExportXlsx}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="Xlsx" />
          <Button Content="{x:Static r:Strings.Menu_Print}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="Print" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{x:Static r:Strings.Matrix_Legend}" />
          <ItemsControl ItemsSource="{Binding Legend}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelChip">
                <Border Classes="chip" Background="{Binding Background}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground}" Text="{Binding Abbrev, StringFormat='[{0}]'}"
                               IsVisible="{Binding $parent[UserControl].((vm:MatrixViewModel)DataContext).Display.ShowLevelAbbreviations, FallbackValue=True}" />
                    <TextBlock FontSize="13" Foreground="{Binding Foreground}" Text="{Binding Name}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>

      <Grid ColumnDefinitions="28,*" RowDefinitions="*,Auto">
        <!-- Eje Y: impacto, el mayor arriba -->
        <LayoutTransformControl VerticalAlignment="Center">
          <LayoutTransformControl.LayoutTransform>
            <RotateTransform Angle="-90" />
          </LayoutTransformControl.LayoutTransform>
          <TextBlock Classes="muted" FontSize="13" Text="{x:Static r:Strings.Matrix_AxisImpact}" />
        </LayoutTransformControl>

        <StackPanel Grid.Column="1">
          <Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MatrixRow">
                <DockPanel>
                  <!-- Rótulo de la fila, pegado al eje -->
                  <Border DockPanel.Dock="Left" Width="132" BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="0,0,1,0"
                          MinHeight="{Binding MinHeight}" Padding="0,0,12,0">
                    <ContentControl Content="{Binding Level}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="118" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Cells}" Margin="3,0,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MatrixCell">
                        <!-- Doble clic en la celda (fuera de un riesgo): riesgo nuevo con este impacto y esta probabilidad. -->
                        <Border Classes="cell" MinHeight="{Binding MinHeight}" DoubleTapped="OnCellDoubleTapped" ToolTip.Tip="{Binding Tooltip}"
                                Background="{Binding Level.Background, FallbackValue=Transparent}"
                                TextElement.Foreground="{Binding Level.Foreground, FallbackValue=Black}">
                          <DockPanel>
                            <!-- El nivel también en texto, no solo con color (RNF-46); se puede ocultar en Preferencias. -->
                            <TextBlock DockPanel.Dock="Top" Margin="2,0,0,2" FontSize="11" FontWeight="SemiBold" Opacity="0.85"
                                       IsVisible="{Binding $parent[UserControl].((vm:MatrixViewModel)DataContext).Display.ShowLevelAbbreviations, FallbackValue=True}"
                                       Text="{Binding Level.Abbrev, StringFormat='[{0}]', FallbackValue=''}" />
                            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MatrixItem">
                                  <Button Classes="tile" Foreground="{Binding $parent[Border].(TextElement.Foreground)}" ToolTip.Tip="{Binding Tooltip}"
                                          Command="{Binding $parent[UserControl].((vm:MatrixViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                      <ContextMenu>
                                        <MenuItem Header="{x:Static r:Strings.Risks_Edit}" CommandParameter="{Binding}"
                                                  Command="{Binding $parent[UserControl].((vm:MatrixViewModel)DataContext).OpenCommand}" />
                                        <MenuItem Header="{x:Static r:Strings.Risks_Reassess}" CommandParameter="{Binding}"
                                                  Command="{Binding $parent[UserControl].((vm:MatrixViewModel)DataContext).ReassessCommand}" />
                                      </ContextMenu>
                                    </Button.ContextMenu>
                                    <!-- Monto del impacto a la derecha (opcional); dentro de la celda, el mayor arriba. -->
                                    <DockPanel Margin="6,0">
                                      <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Amount}">
                                        <TextBlock.IsVisible>
                                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="HasAmount" />
                                            <Binding Path="$parent[UserControl].((vm:MatrixViewModel)DataContext).Display.ShowImpactAmount" FallbackValue="False" />
                                          </MultiBinding>
                                        </TextBlock.IsVisible>
                                      </TextBlock>
                                      <TextBlock Text="{Binding Title, StringFormat='• {0}'}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Recorrido del riesgo elegido, encima de las celdas (desde el borde del rótulo de las filas). -->
          <views:MatrixPathOverlay Margin="135,0,0,0" IsHitTestVisible="False" Markers="{Binding PathMarkers}"
                                   RowCount="{Binding RowCount}" ColumnCount="{Binding ColumnCount}" />
          </Grid>

          <!-- Eje X: probabilidad, de menor a mayor hacia la derecha -->
          <DockPanel>
            <Border DockPanel.Dock="Left" Width="132" />
            <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="3,8,0,0">
              <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LevelChip">
                    <ContentControl Content="{Binding}" Margin="3,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="13" Margin="132,10,0,0" HorizontalAlignment="Center" Text="{x:Static r:Strings.Matrix_AxisProbability}" />
      </Grid>
    </DockPanel>
  </ScrollViewer>
</UserControl>
