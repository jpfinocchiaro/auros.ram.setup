<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.PasswordWindow"
        x:DataType="vm:PasswordDialogViewModel"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="h2" Text="{Binding Title}" />
    <TextBlock Classes="muted" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />

    <StackPanel IsVisible="{Binding !IsCreate}">
      <TextBlock Classes="label" Text="{Binding FirstLabel}" />
      <TextBox x:Name="CurrentBox" PasswordChar="•" Text="{Binding Current}" />
    </StackPanel>

    <StackPanel IsVisible="{Binding NeedsNew}" Spacing="12">
      <StackPanel>
        <TextBlock Classes="label" Text="{x:Static r:Strings.Password_New}" />
        <TextBox x:Name="NewBox" PasswordChar="•" Text="{Binding NewPassword}" />
        <!-- RNF-35: indicador de fortaleza -->
        <ProgressBar Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding StrengthValue}" Foreground="{Binding StrengthBrush}" Height="6" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding StrengthText}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="label" Text="{x:Static r:Strings.Password_Confirm}" />
        <TextBox PasswordChar="•" Text="{Binding Confirmation}" />
      </StackPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Password_OptionalHint}" />
    </StackPanel>

    <!-- Por ahora la contraseña es opcional: aviso de que sin ella el archivo no se cifra. -->
    <Border IsVisible="{Binding WithoutPassword}" Background="{DynamicResource WarningBackBrush}" CornerRadius="6" Padding="12">
      <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Password_NoneWarning}" />
    </Border>

    <!-- RNF-34: sin recuperación de contraseña -->
    <Border IsVisible="{Binding ShowNoRecovery}" Background="{DynamicResource WarningBackBrush}" CornerRadius="6" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{x:Static r:Strings.Password_NoRecoveryTitle}" />
        <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Password_NoRecoveryText}" />
        <CheckBox IsChecked="{Binding Acknowledged}">
          <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Password_Acknowledge}" />
        </CheckBox>
      </StackPanel>
    </Border>

    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" IsEnabled="{Binding !IsBusy}" />
      <Button ui:ButtonIcon.Icon="{StaticResource IconCheck}" Classes="accent" Content="{x:Static r:Strings.Common_Accept}" IsDefault="True" Click="OnAccept" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </StackPanel>
</Window>
