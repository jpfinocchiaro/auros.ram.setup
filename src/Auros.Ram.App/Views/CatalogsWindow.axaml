<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.CatalogsWindow"
        x:DataType="vm:CatalogsViewModel"
        Title="{x:Static r:Strings.Catalog_Title}"
        Width="920" Height="600" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <!-- Catálogos de la matriz: las opciones de los combos de consecuencias y de criterio de materialidad. -->
  <Window.DataTemplates>
    <DataTemplate x:DataType="vm:CatalogListViewModel">
      <Border Classes="card" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Margin="0,0,0,8" Text="{Binding Title}" />
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static r:Strings.Risk_AddConsequence}" Command="{Binding AddCommand}" />
            <TextBox Text="{Binding NewName}" MaxLength="80" Watermark="{x:Static r:Strings.Catalog_NewHint}" />
          </DockPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogRow">
                  <Grid ColumnDefinitions="*,110,Auto" Margin="0,0,0,6">
                    <TextBox Text="{Binding Name}" MaxLength="80" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding Usage}" />
                    <Button Grid.Column="2" Content="✕" ToolTip.Tip="{x:Static r:Strings.Catalog_Remove}"
                            Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="{x:Static r:Strings.Catalog_Title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Catalog_Hint}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Classes="accent" HorizontalAlignment="Right" Content="{x:Static r:Strings.Common_Close}" Click="OnClose" />
    </StackPanel>
    <Grid ColumnDefinitions="*,12,*">
      <ContentControl Content="{Binding Consequences}" />
      <ContentControl Grid.Column="2" Content="{Binding Materiality}" />
    </Grid>
  </DockPanel>
</Window>
