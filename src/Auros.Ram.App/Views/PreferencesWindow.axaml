<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="{x:Static r:Strings.Menu_Preferences}"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Classes="h2" Text="{x:Static r:Strings.Menu_Preferences}" />
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Prefs_Autosave}" />
      <NumericUpDown Value="{Binding AutosaveMinutes}" Minimum="1" Maximum="60" Increment="1" FormatString="0" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_AutosaveHint}" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Prefs_Lock}" />
      <NumericUpDown Value="{Binding LockMinutes}" Minimum="1" Maximum="240" Increment="1" FormatString="0" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_LockHint}" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_Abbreviations}" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="abbrev" IsChecked="{Binding ShowAbbreviations}" Content="{x:Static r:Strings.Common_Yes}" />
        <RadioButton GroupName="abbrev" IsChecked="{Binding HideAbbreviations}" Content="{x:Static r:Strings.Common_No}" />
      </StackPanel>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_AbbreviationsHint}" />
    </StackPanel>
    <!-- Fechas de evaluación: qué fechas anteriores se permiten (si se permiten, el editor solo advierte). -->
    <StackPanel Spacing="4">
      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_Dates}" />
      <CheckBox IsChecked="{Binding AllowPastDateOnCreate}">
        <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_DatePastOnCreate}" />
      </CheckBox>
      <CheckBox IsChecked="{Binding AllowDateBeforeRecorded}">
        <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_DateBeforeRecorded}" />
      </CheckBox>
      <CheckBox IsChecked="{Binding AllowPastDateOnEdit}">
        <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_DatePastOnEdit}" />
      </CheckBox>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_DatesHint}" />
    </StackPanel>
    <!-- Carga de impacto y probabilidad: qué dato es obligatorio y si el nivel se ajusta solo según los rangos. -->
    <StackPanel Spacing="6">
      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_Entry}" />
      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
        <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.ScaleType_Impact}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ImpactEntries}" SelectedItem="{Binding ImpactEntry}" />
        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ImpactAuto}">
          <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_ImpactAuto}" />
        </CheckBox>
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static r:Strings.Risks_ProbabilityShort}" />
        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ProbabilityEntries}" SelectedItem="{Binding ProbabilityEntry}" />
        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ProbabilityAuto}">
          <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_ProbabilityAuto}" />
        </CheckBox>
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_EntryHint}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button ui:ButtonIcon.Icon="{StaticResource IconSave}" Classes="accent" Content="{x:Static r:Strings.Common_Save}" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
