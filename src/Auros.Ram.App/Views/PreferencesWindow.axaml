<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="{x:Static r:Strings.Menu_Preferences}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Classes="h2" Text="{x:Static r:Strings.Menu_Preferences}" />
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Prefs_Autosave}" />
      <NumericUpDown Value="{Binding AutosaveMinutes}" Minimum="1" Maximum="60" Increment="1" FormatString="0" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_AutosaveHint}" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Prefs_Lock}" />
      <NumericUpDown Value="{Binding LockMinutes}" Minimum="1" Maximum="240" Increment="1" FormatString="0" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_LockHint}" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_Abbreviations}" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="abbrev" IsChecked="{Binding ShowAbbreviations}" Content="{x:Static r:Strings.Common_Yes}" />
        <RadioButton GroupName="abbrev" IsChecked="{Binding HideAbbreviations}" Content="{x:Static r:Strings.Common_No}" />
      </StackPanel>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Prefs_AbbreviationsHint}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="{x:Static r:Strings.Common_Save}" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
