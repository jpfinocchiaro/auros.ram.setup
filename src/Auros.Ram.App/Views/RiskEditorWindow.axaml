<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        xmlns:views="using:Auros.Ram.App.Views"
        xmlns:sys="using:System"
        x:Class="Auros.Ram.App.Views.RiskEditorWindow"
        x:DataType="vm:RiskEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="880" Height="720" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
        <Button ui:ButtonIcon.Icon="{StaticResource IconSave}" Classes="accent" Content="{x:Static r:Strings.Common_Save}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>

    <!-- Qué se está haciendo: alta, edición (corrige datos) o nueva evaluación (registra un estado con fecha).
         Cada modo con su color en el borde izquierdo, para no confundirlos. -->
    <Border DockPanel.Dock="Top" Classes="modeBanner" Classes.edit="{Binding IsEdit}" Classes.reassess="{Binding IsReassess}"
            Background="{DynamicResource SurfaceBrush}" BorderThickness="6,0,0,0" CornerRadius="3" Padding="14,10" Margin="0,0,0,14">
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" Text="{Binding ModeTitle}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ModeHint}" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="14" Margin="0,0,12,0">
        <!-- Nueva evaluación: el riesgo se ve (título y resumen), sus textos no se editan aquí. -->
        <Border Classes="card" Padding="12" IsVisible="{Binding IsReassess}">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{x:Static r:Strings.Mode_RiskLabel}" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            <views:RichTextBlock Markup="{Binding ShortDescription}" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding CanEditTexts}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding TitleCounter}" />
            <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_Title}" />
          </DockPanel>
          <TextBox x:Name="TitleBox" Text="{Binding Title}" MaxLength="{Binding TitleMax}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding CanEditTexts}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding ShortCounter}" />
            <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_ShortHint}" />
          </DockPanel>
          <!-- Descripciones con formato directo: barra de botones sobre el texto. -->
          <views:FormattedTextEditor Text="{Binding ShortDescription}" EditorHeight="90" />
        </StackPanel>
        <StackPanel IsVisible="{Binding CanEditTexts}">
          <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_LongHint}" />
          <views:FormattedTextEditor Text="{Binding LongDescription}" EditorHeight="190" />
        </StackPanel>

        <!-- Consecuencias potenciales (varias) y criterio de materialidad (uno), de los catálogos de la matriz.
             Los combos permiten elegir una opción o escribir una nueva, que se agrega al catálogo. -->
        <Border Classes="card" Padding="12" IsVisible="{Binding CanEditTexts}">
          <StackPanel Spacing="10">
            <!-- Empresa y unidad de negocio (obligatorias), de los maestros de la matriz; se puede escribir una nueva. -->
            <Grid ColumnDefinitions="*,12,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_Company}" />
                <ComboBox x:Name="CompanyBox" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding CompanyOptions}"
                          Text="{Binding Company}" PlaceholderText="{x:Static r:Strings.Risk_CompanyHint}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_Unit}" />
                <ComboBox x:Name="UnitBox" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding UnitOptions}"
                          Text="{Binding Unit}" PlaceholderText="{x:Static r:Strings.Risk_UnitHint}" />
              </StackPanel>
              <Button Grid.Column="3" ui:ButtonIcon.Icon="{StaticResource IconEdit}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                      ToolTip.Tip="{x:Static r:Strings.Org_EditTip}" Command="{Binding EditOrganizationsCommand}"
                      IsVisible="{Binding CanEditOrganizations}" />
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_Consequences}" />
              <ItemsControl ItemsSource="{Binding Consequences}" IsVisible="{Binding HasConsequences}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConsequenceChoice">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <Button Content="✕" Padding="5,0" MinHeight="0" Background="Transparent" BorderThickness="0" FontSize="11"
                                ToolTip.Tip="{x:Static r:Strings.Risk_RemoveConsequence}"
                                Command="{Binding $parent[Window].((vm:RiskEditorViewModel)DataContext).RemoveConsequenceCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button ui:ButtonIcon.Icon="{StaticResource IconAdd}" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static r:Strings.Risk_AddConsequence}" Command="{Binding AddConsequenceCommand}" />
                <ComboBox x:Name="ConsequenceBox" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding ConsequenceOptions}"
                          Text="{Binding NewConsequence}" PlaceholderText="{x:Static r:Strings.Risk_ConsequenceHint}" />
              </DockPanel>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{x:Static r:Strings.Risk_Materiality}" />
              <ComboBox IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding MaterialityOptions}"
                        Text="{Binding Materiality}" PlaceholderText="{x:Static r:Strings.Risk_MaterialityHint}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- RF-10: cada nivel se elige con botones de color, con su justificación debajo -->
        <ItemsControl ItemsSource="{Binding Dimensions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DimensionEditor">
              <Border Classes="card" Margin="0,0,0,10" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock>
                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding ScaleName, StringFormat=' ({0})', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                    <Run Text=" — " Foreground="{DynamicResource MutedTextBrush}" />
                    <Run Text="{Binding SelectedText, Mode=OneWay}" FontWeight="SemiBold" />
                  </TextBlock>
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LevelOption">
                        <ToggleButton IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                      Background="{Binding Chip.Background}" Margin="0,0,8,6" Padding="12,6" MinWidth="96"
                                      BorderThickness="3" Classes="levelOption">
                          <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="✓" FontWeight="Bold" Foreground="{Binding Chip.Foreground}" IsVisible="{Binding IsSelected}" />
                              <TextBlock Text="{Binding Chip.Name}" FontWeight="SemiBold" Foreground="{Binding Chip.Foreground}" />
                            </StackPanel>
                            <!-- Rango del nivel, si tiene -->
                            <TextBlock Text="{Binding Chip.RangeText}" FontSize="11" Foreground="{Binding Chip.Foreground}" Opacity="0.85"
                                       IsVisible="{Binding Chip.RangeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Monto del impacto o probabilidad en %: con ajuste automático elige el nivel según los rangos. -->
                  <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto">
                    <TextBlock Classes="label" Text="{Binding ValueLabel}" Grid.ColumnSpan="3" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Value}" Minimum="0" Maximum="{Binding ValueMax}" Increment="1"
                                   FormatString="N2" ShowButtonSpinner="False" Width="200" />
                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ValueHint}" />
                      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ValueWarning}"
                                 IsVisible="{Binding ValueWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </Grid>
                  <TextBox Text="{Binding Justification}" AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                           Watermark="{x:Static r:Strings.Risk_JustificationHint}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Edición con otro impacto o probabilidad: se corrige la evaluación vigente; se ofrece registrarlo como nueva evaluación. -->
        <Border Background="{DynamicResource WarningBackBrush}" CornerRadius="4" Padding="12,8" IsVisible="{Binding IsCorrecting}">
          <DockPanel>
            <Button ui:ButtonIcon.Icon="{StaticResource IconReassess}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{x:Static r:Strings.Mode_SwitchToReassess}" Command="{Binding SwitchToReassessCommand}" />
            <TextBlock Text="{Binding CorrectionHint}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
        </Border>

        <!-- El nivel de riesgo no se elige: resulta del impacto y la probabilidad (mapa de calor). -->
        <Border Classes="card" Padding="12">
          <DockPanel>
            <ContentControl DockPanel.Dock="Right" Content="{Binding RiskLevel}" VerticalAlignment="Center" />
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding RiskLevelLabel}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.Risk_LevelFromHeatMap}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Evaluación: al dar de alta y al cambiar impacto o probabilidad, con su fecha (editable) y un comentario. -->
        <Border Classes="card" Padding="12" IsVisible="{Binding ShowAssessment}" BorderBrush="{DynamicResource BrandBlueBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding AssessmentTitle}" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding AssessmentHint}" />
            <Grid ColumnDefinitions="Auto,12,*">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{x:Static r:Strings.History_Date}" />
                <CalendarDatePicker x:Name="AssessmentDatePicker" SelectedDate="{Binding AssessmentDate}" Width="160"
                                    DisplayDateEnd="{x:Static sys:DateTime.Today}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Classes="label" Text="{x:Static r:Strings.History_Note}" />
                <TextBox Text="{Binding AssessmentNote}" Watermark="{x:Static r:Strings.History_NoteHint}" />
              </StackPanel>
            </Grid>
            <!-- Fecha anterior a hoy o a otra evaluación: advertencia (o aviso de que la configuración no lo permite). -->
            <Border Background="{DynamicResource WarningBackBrush}" CornerRadius="4" Padding="10,6"
                    IsVisible="{Binding DateWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding DateWarning}" TextWrapping="Wrap" FontSize="12" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Historial: evolución del nivel de riesgo en el tiempo y cada evaluación registrada. -->
        <Border Classes="card" Padding="12" IsVisible="{Binding HasHistory}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static r:Strings.History_Title}" FontWeight="SemiBold" />
            <views:EvolutionChart Height="150" Points="{Binding ChartPoints}" LevelNames="{Binding ChartLevels}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.History_DateEditHint}" />
            <Grid ColumnDefinitions="150,170,170,110,*,32" Margin="0,4,0,2">
              <TextBlock Classes="label" Text="{x:Static r:Strings.History_ColDate}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:Strings.ScaleType_Impact}" />
              <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:Strings.Risks_ProbabilityShort}" />
              <TextBlock Grid.Column="3" Classes="label" Text="{x:Static r:Strings.ScaleType_Risk}" />
              <TextBlock Grid.Column="4" Classes="label" Text="{x:Static r:Strings.History_Note}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryEntry">
                  <!-- Una evaluación por línea, compacta: el monto y el % al lado de su nivel, con una línea divisoria. -->
                  <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                    <Grid ColumnDefinitions="150,170,170,110,*,32">
                      <!-- La fecha de cada evaluación se puede corregir (según lo que permitan las Preferencias). -->
                      <CalendarDatePicker Classes="compact" SelectedDate="{Binding Date}" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          DisplayDateEnd="{x:Static sys:DateTime.Today}" ToolTip.Tip="{x:Static r:Strings.History_DateEditTip}"
                                          FontWeight="{Binding IsCurrent, Converter={x:Static vm:Converters.BoldIf}}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Impact}" />
                        <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding ImpactValue}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Probability}" />
                        <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding ProbabilityValue}" />
                      </StackPanel>
                      <ContentControl Grid.Column="3" Content="{Binding RiskLevel}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="4" Text="{Binding Note}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding Note}" />
                      <Button Grid.Column="5" Classes="compact" Content="✕" VerticalAlignment="Center" IsVisible="{Binding CanRemove}"
                              ToolTip.Tip="{x:Static r:Strings.History_RemoveTip}"
                              Command="{Binding $parent[Window].((vm:RiskEditorViewModel)DataContext).RemoveAssessmentCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

  <Window.Styles>
    <!-- Historial compacto: selector de fecha y botón de quitar más bajos. -->
    <Style Selector="CalendarDatePicker.compact">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0,4,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- Color del modo: verde petróleo (alta), gris (edición), azul (nueva evaluación). -->
    <Style Selector="Border.modeBanner">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.modeBanner.edit">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Border.modeBanner.reassess">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBlueBrush}" />
    </Style>
    <!-- El nivel elegido se marca con borde grueso y ✓, no solo con color (RNF-46). -->
    <Style Selector="ToggleButton.levelOption">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.levelOption:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
    </Style>
    <Style Selector="ToggleButton.levelOption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="ToggleButton.levelOption:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
  </Window.Styles>
</Window>
