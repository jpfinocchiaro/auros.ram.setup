<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:views="using:Auros.Ram.App.Views"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="auros.ram"
        Width="1280" Height="820" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource SurfaceAltBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}">
      <MenuItem Header="{x:Static r:Strings.Menu_File}">
        <MenuItem x:Name="MiNew" Header="{x:Static r:Strings.Menu_New}" Command="{Binding NewCommand}" />
        <MenuItem x:Name="MiOpen" Header="{x:Static r:Strings.Menu_Open}" Command="{Binding OpenCommand}" />
        <MenuItem Header="{x:Static r:Strings.Menu_Recent}" ItemsSource="{Binding Recent}" IsEnabled="{Binding HasRecent}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{ReflectionBinding Path}" />
              <Setter Property="Command" Value="{ReflectionBinding $parent[Window].DataContext.OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{ReflectionBinding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="MiSave" Header="{x:Static r:Strings.Menu_Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" />
        <MenuItem x:Name="MiSaveAs" Header="{x:Static r:Strings.Menu_SaveAs}" Command="{Binding SaveAsCommand}" IsEnabled="{Binding CanEdit}" />
        <MenuItem Header="{x:Static r:Strings.Menu_ChangePassword}" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding CanEdit}" />
        <Separator />
        <MenuItem Header="{x:Static r:Strings.Menu_ImportJson}" Command="{Binding ImportJsonCommand}" />
        <MenuItem Header="{x:Static r:Strings.Menu_Export}" IsEnabled="{Binding CanEdit}">
          <MenuItem Header="{x:Static r:Strings.Menu_ExportXlsx}" Command="{Binding ExportCommand}" CommandParameter="Xlsx" />
          <Separator />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportPdfAll}" Command="{Binding ExportCommand}" CommandParameter="PdfAll" />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportPdfMatrix}" Command="{Binding ExportCommand}" CommandParameter="PdfMatrix" />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportPdfSummary}" Command="{Binding ExportCommand}" CommandParameter="PdfSummary" />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportPdfDetail}" Command="{Binding ExportCommand}" CommandParameter="PdfDetail" />
          <Separator />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportCsvRisks}" Command="{Binding ExportCommand}" CommandParameter="CsvRisks" />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportCsvMatrix}" Command="{Binding ExportCommand}" CommandParameter="CsvMatrix" />
          <Separator />
          <MenuItem Header="{x:Static r:Strings.Menu_ExportJson}" Command="{Binding ExportCommand}" CommandParameter="Json" />
        </MenuItem>
        <MenuItem x:Name="MiPrint" Header="{x:Static r:Strings.Menu_Print}" Command="{Binding ExportCommand}" CommandParameter="Print" IsEnabled="{Binding CanEdit}" />
        <Separator />
        <MenuItem x:Name="MiLock" Header="{x:Static r:Strings.Menu_Lock}" Command="{Binding LockNowCommand}" IsEnabled="{Binding HasDocuments}" />
        <MenuItem x:Name="MiClose" Header="{x:Static r:Strings.Menu_Close}" Command="{Binding CloseCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding HasActive}" />
        <MenuItem Header="{x:Static r:Strings.Menu_Exit}" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="{x:Static r:Strings.Menu_Edit}">
        <MenuItem x:Name="MiUndo" Header="{Binding Active.UndoText, FallbackValue={x:Static r:Strings.Menu_Undo}}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanEdit}" />
        <MenuItem x:Name="MiRedo" Header="{Binding Active.RedoText, FallbackValue={x:Static r:Strings.Menu_Redo}}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanEdit}" />
        <Separator />
        <MenuItem x:Name="MiNewRisk" Header="{x:Static r:Strings.Menu_NewRisk}" Command="{Binding NewRiskCommand}" IsEnabled="{Binding CanEdit}" />
      </MenuItem>
      <MenuItem Header="{x:Static r:Strings.Menu_View}" IsEnabled="{Binding HasActive}">
        <MenuItem x:Name="MiProject" Header="{x:Static r:Strings.Section_Project}" Command="{Binding ShowSectionCommand}" CommandParameter="Project">
          <MenuItem.Icon><PathIcon Classes="nav" Data="{StaticResource IconProject}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MiRisks" Header="{x:Static r:Strings.Section_Risks}" Command="{Binding ShowSectionCommand}" CommandParameter="Risks">
          <MenuItem.Icon><PathIcon Classes="nav" Data="{StaticResource IconRisks}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MiMatrix" Header="{x:Static r:Strings.Section_Matrix}" Command="{Binding ShowSectionCommand}" CommandParameter="Matrix">
          <MenuItem.Icon><PathIcon Classes="nav" Data="{StaticResource IconMatrix}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MiReports" Header="{x:Static r:Strings.Section_Reports}" Command="{Binding ShowSectionCommand}" CommandParameter="Reports">
          <MenuItem.Icon><PathIcon Classes="nav" Data="{StaticResource IconReports}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{x:Static r:Strings.Menu_Settings}">
        <MenuItem x:Name="MiScales" Header="{x:Static r:Strings.Section_Scales}" Command="{Binding ShowSectionCommand}" CommandParameter="Scales" IsEnabled="{Binding HasActive}">
          <MenuItem.Icon><PathIcon Classes="nav" Data="{StaticResource IconScales}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static r:Strings.Menu_Preferences}" Command="{Binding PreferencesCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static r:Strings.Menu_Help}">
        <MenuItem Header="{x:Static r:Strings.Menu_About}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Version, StringFormat='auros.ram {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding Active.IsBusy, FallbackValue=False}" />
          <TextBlock Classes="muted" Text="{Binding Active.Status, FallbackValue=''}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel>
      <views:WelcomeView IsVisible="{Binding !HasDocuments}" />
      <TabControl Classes="files" IsVisible="{Binding HasDocuments}" ItemsSource="{Binding Documents}" SelectedItem="{Binding Active}" Padding="0">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
              <TextBlock Text="🔒" IsVisible="{Binding IsLocked}" VerticalAlignment="Center" />
              <Button Content="✕" Padding="5,1" Background="Transparent" BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static r:Strings.Menu_Close}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <views:DocumentView />
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Panel>
  </DockPanel>
</Window>
