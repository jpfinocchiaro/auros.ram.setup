<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Auros.Ram.App.ViewModels"
             xmlns:r="using:Auros.Ram.App.Resources"
             xmlns:views="using:Auros.Ram.App.Views"
             xmlns:sys="using:System"
             x:Class="Auros.Ram.App.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <UserControl.Styles>
    <!-- Riesgo en una foto de la película; los que cambiaron en esa foto, con borde y un parpadeo al aparecer. -->
    <Style Selector="Border.frameTile">
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.frameTile.changed">
      <Setter Property="BorderBrush" Value="{Binding $parent[Border].(TextElement.Foreground)}" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
      <Style.Animations>
        <Animation Duration="0:0:0.6" IterationCount="2" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <TabControl Classes="sub" Margin="24,8,24,0" Padding="0,8,0,0">
    <!-- RF-16: Ficha resumen de oportunidades de mejora -->
    <TabItem Header="{x:Static r:Strings.Reports_Summary}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button ui:ButtonIcon.Icon="{StaticResource IconPdf}" Content="{x:Static r:Strings.Reports_ExportPdf}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="PdfSummary" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconTable}" Content="{x:Static r:Strings.Matrix_ExportXlsx}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="Xlsx" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconTable}" Content="{x:Static r:Strings.Reports_ExportCsv}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="CsvRisks" />
        </StackPanel>
        <Border Classes="card" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="44,2*,3*,120,120,120" Margin="12,8">
              <TextBlock Classes="label" Text="N°" />
              <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:Strings.Risks_ColRisk}" />
              <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:Strings.Risk_Short}" />
              <TextBlock Grid.Column="3" Classes="label" Text="{x:Static r:Strings.ScaleType_Risk}" />
              <TextBlock Grid.Column="4" Classes="label" Text="{x:Static r:Strings.ScaleType_Impact}" />
              <TextBlock Grid.Column="5" Classes="label" Text="{x:Static r:Strings.Risks_ProbabilityShort}" />
            </Grid>
            <ListBox ItemsSource="{Binding Items}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportItem">
                  <Grid ColumnDefinitions="44,2*,3*,120,120,120" Margin="0,4">
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <views:RichTextBlock Grid.Column="2" Markup="{Binding ShortDescription}" Margin="0,0,12,0" />
                    <ContentControl Grid.Column="3" Content="{Binding RiskLevel}" VerticalAlignment="Top" />
                    <ContentControl Grid.Column="4" Content="{Binding ImpactLevel}" VerticalAlignment="Top" />
                    <ContentControl Grid.Column="5" Content="{Binding ProbabilityLevel}" VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </DockPanel>
    </TabItem>

    <!-- Evolución de los riesgos entre dos fechas: cómo empezaron, cómo terminaron y qué cambios hubo. -->
    <TabItem Header="{x:Static r:Strings.Evolution_Tab}">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Evolution_From}" />
            <CalendarDatePicker SelectedDate="{Binding FromDate}" Width="150" Watermark="{x:Static r:Strings.Evolution_FromHint}"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Evolution_To}" />
            <CalendarDatePicker SelectedDate="{Binding ToDate}" Width="150" Watermark="{x:Static r:Strings.Matrix_Today}"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}" />
          </StackPanel>
          <Button ui:ButtonIcon.Icon="{StaticResource IconPdf}" Content="{x:Static r:Strings.Reports_ExportPdf}" Margin="0,0,8,4"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="PdfEvolution" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconTable}" Content="{x:Static r:Strings.Matrix_ExportXlsx}" Margin="0,0,8,4"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="Xlsx" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,8" Text="{Binding EvolutionSummary}" />
        <Border Classes="card" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,330,330,130,3*" Margin="12,8">
              <TextBlock Classes="label" Text="{x:Static r:Strings.Risks_ColRisk}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:Strings.Evolution_Start}" />
              <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:Strings.Evolution_End}" />
              <TextBlock Grid.Column="3" Classes="label" Text="{x:Static r:Strings.Evolution_Trend}" />
              <TextBlock Grid.Column="4" Classes="label" Text="{x:Static r:Strings.Evolution_Changes}" />
            </Grid>
            <ListBox ItemsSource="{Binding Evolution}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EvolutionItem">
                  <Grid ColumnDefinitions="2*,330,330,130,3*" Margin="0,4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <!-- Nivel · Impacto · Probabilidad al inicio (o "no evaluado" si es nuevo) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasStart}" VerticalAlignment="Top">
                      <ContentControl Content="{Binding StartLevel}" />
                      <ContentControl Content="{Binding StartImpact}" />
                      <ContentControl Content="{Binding StartProbability}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="muted" FontStyle="Italic" IsVisible="{Binding IsNew}" Text="{x:Static r:Strings.Evolution_NotAssessed}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                      <ContentControl Content="{Binding EndLevel}" />
                      <ContentControl Content="{Binding EndImpact}" />
                      <ContentControl Content="{Binding EndProbability}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding TrendText}" FontWeight="SemiBold" Foreground="{Binding TrendBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding Changes}" TextWrapping="Wrap" FontSize="13" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </DockPanel>
    </TabItem>

    <!-- Película de la matriz: las "fotos" de la matriz entre dos fechas, una tras otra, cada una durante n segundos.
         Los riesgos que cambiaron en cada foto se resaltan y se listan a la derecha. -->
    <TabItem Header="{x:Static r:Strings.Playback_Tab}">
      <DockPanel DataContext="{Binding Playback}" x:DataType="vm:MatrixPlaybackViewModel">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,4">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Evolution_From}" />
            <CalendarDatePicker SelectedDate="{Binding FromDate}" Width="150" Watermark="{x:Static r:Strings.Evolution_FromHint}"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Evolution_To}" />
            <CalendarDatePicker SelectedDate="{Binding ToDate}" Width="150" Watermark="{x:Static r:Strings.Matrix_Today}"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,4">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Playback_Seconds}" />
            <NumericUpDown Value="{Binding Seconds}" Minimum="0.5" Maximum="60" Increment="0.5" FormatString="0.#" Width="120" />
          </StackPanel>
          <CheckBox IsChecked="{Binding Loop}" Content="{x:Static r:Strings.Playback_Loop}" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- Controles de reproducción y línea de tiempo -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="⏮" Command="{Binding FirstCommand}" ToolTip.Tip="{x:Static r:Strings.Playback_First}" />
              <Button Content="◀" Command="{Binding PreviousCommand}" ToolTip.Tip="{x:Static r:Strings.Playback_Previous}" />
              <Button Classes="accent" MinWidth="130" Content="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}" />
              <Button Content="▶" Command="{Binding NextCommand}" ToolTip.Tip="{x:Static r:Strings.Playback_Next}" />
              <Button Content="⏭" Command="{Binding LastCommand}" ToolTip.Tip="{x:Static r:Strings.Playback_Last}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Counter}" />
            <Slider Minimum="0" Maximum="{Binding LastIndex}" Value="{Binding Index}" TickFrequency="1"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="16,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="h1" Margin="0,0,0,8" Text="{Binding FrameTitle}" />

        <!-- Cambios de esta foto -->
        <Border DockPanel.Dock="Right" Classes="card" Width="320" Margin="12,0,0,0" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{x:Static r:Strings.Playback_Changes}" />
            <TextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding !HasChanges}"
                       Text="{x:Static r:Strings.Playback_NoChanges}" />
            <ItemsControl ItemsSource="{Binding Current.Changes, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="13" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- La matriz de la foto: impacto (filas, el mayor arriba) × probabilidad (columnas) -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Current.Rows, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaybackRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="128" MinHeight="{Binding MinHeight}" Padding="0,0,10,0"
                            BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="0,0,1,0">
                      <ContentControl Content="{Binding Level}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="116" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cells}" Margin="3,0,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaybackCell">
                          <Border CornerRadius="2" Margin="2" Padding="5,4" MinHeight="{Binding MinHeight}"
                                  Background="{Binding Level.Background, FallbackValue=Transparent}"
                                  TextElement.Foreground="{Binding Level.Foreground, FallbackValue=Black}">
                            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaybackItem">
                                  <Border Classes="frameTile" Classes.changed="{Binding Changed}" ToolTip.Tip="{Binding Tooltip}">
                                    <TextBlock Text="{Binding Title, StringFormat='• {0}'}" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource CondensedFontFamily}" FontSize="13" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,4,0,0">
              <Border DockPanel.Dock="Left" Width="128" />
              <ItemsControl ItemsSource="{Binding Columns}" Margin="3,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LevelChip">
                    <ContentControl Content="{Binding}" Margin="3,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <TextBlock Classes="muted" FontSize="12" Margin="131,8,0,0" HorizontalAlignment="Center"
                       Text="{x:Static r:Strings.Playback_Axes}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

    <!-- Imagen de la matriz: para guardar como PNG o copiar y pegar en PowerPoint o Word. Siempre en tema claro. -->
    <TabItem Header="{x:Static r:Strings.Image_Tab}">
      <DockPanel DataContext="{Binding Image}" x:DataType="vm:MatrixImageViewModel">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Matrix_AsOf}" />
            <CalendarDatePicker SelectedDate="{Binding AsOfDate}" Width="150" Watermark="{x:Static r:Strings.Matrix_Today}"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static r:Strings.Image_Resolution}" />
            <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" Width="190" />
          </StackPanel>
          <Button ui:ButtonIcon.Icon="{StaticResource IconCopy}" Content="{x:Static r:Strings.Image_Copy}" Classes="accent" Command="{Binding CopyImageCommand}" Margin="0,0,8,4"
                  ToolTip.Tip="{x:Static r:Strings.Image_CopyTip}" />
          <Button ui:ButtonIcon.Icon="{StaticResource IconImage}" Content="{x:Static r:Strings.Image_Save}" Command="{Binding SaveImageCommand}" Margin="0,0,8,4" />
        </WrapPanel>
        <!-- Qué partes lleva la imagen: se puede quitar cualquiera para copiar o guardar solo lo que haga falta. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" Classes="muted" Margin="0,0,10,4" Text="{x:Static r:Strings.Image_Show}" />
          <CheckBox IsChecked="{Binding ShowTitle}" Content="{x:Static r:Strings.Image_ShowTitle}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowSubtitle}" Content="{x:Static r:Strings.Image_ShowSubtitle}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowLogo}" Content="{x:Static r:Strings.Image_ShowLogo}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowLevelLabels}" Content="{x:Static r:Strings.Image_ShowLevelLabels}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowAxisNames}" Content="{x:Static r:Strings.Image_ShowAxisNames}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowRisks}" Content="{x:Static r:Strings.Image_ShowRisks}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowAmounts}" Content="{x:Static r:Strings.Matrix_ShowAmount}" Margin="0,0,12,4" IsEnabled="{Binding ShowRisks}" />
          <CheckBox IsChecked="{Binding ShowAbbreviations}" Content="{x:Static r:Strings.Image_ShowAbbreviations}" Margin="0,0,12,4" />
          <CheckBox IsChecked="{Binding ShowLegend}" Content="{x:Static r:Strings.Image_ShowLegend}" Margin="0,0,12,4" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,8" Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Vista previa: la imagen se dibuja a 1280 de ancho y se achica para entrar en pantalla. -->
        <Border Classes="card" Padding="12">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
            <ThemeVariantScope RequestedThemeVariant="Light">
              <Border x:Name="ImageRoot" Width="1280" Background="White" Padding="36,28" TextElement.Foreground="#1C2733">
                <DockPanel>
                  <!-- Título, proyecto y logo -->
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22" IsVisible="{Binding HasHeader}">
                    <Image DockPanel.Dock="Right" Source="{Binding CompanyLogo}" Height="54" MaxWidth="220" Stretch="Uniform" VerticalAlignment="Center"
                           IsVisible="{Binding ShowLogo}" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" IsVisible="{Binding ShowTitle}" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="#5E6A75" IsVisible="{Binding ShowSubtitle}" />
                    </StackPanel>
                  </DockPanel>

                  <!-- Leyenda -->
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,22,0,0" IsVisible="{Binding ShowLegend}">
                    <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#5E6A75" Text="{x:Static r:Strings.Matrix_Legend}" />
                    <ItemsControl ItemsSource="{Binding Legend}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LevelChip">
                          <Border Background="{Binding Background}" CornerRadius="3" Padding="10,4">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{Binding Foreground}" Text="{Binding Name}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Matriz: impacto en filas (el mayor arriba) y probabilidad en columnas -->
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
                    <LayoutTransformControl VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding ShowAxisNames}">
                      <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="-90" />
                      </LayoutTransformControl.LayoutTransform>
                      <TextBlock FontSize="17" Foreground="#5E6A75" Text="{x:Static r:Strings.Matrix_AxisImpact}" />
                    </LayoutTransformControl>
                    <StackPanel Grid.Column="1">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PlaybackRow">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="150" MinHeight="{Binding MinHeight}" Padding="0,0,12,0"
                                      BorderBrush="#5E6A75" BorderThickness="0,0,1,0"
                                      IsVisible="{Binding $parent[UserControl].((vm:ReportsViewModel)DataContext).Image.ShowLevelLabels, FallbackValue=True}">
                                <Border Background="{Binding Level.Background}" CornerRadius="3" Padding="9,4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding Level.Foreground}" Text="{Binding Level.Name}"
                                             TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                </Border>
                              </Border>
                              <ItemsControl ItemsSource="{Binding Cells}" Margin="3,0,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:PlaybackCell">
                                    <Border CornerRadius="3" Margin="2.5" Padding="7,5" MinHeight="{Binding MinHeight}"
                                            Background="{Binding Level.Background, FallbackValue=Transparent}"
                                            TextElement.Foreground="{Binding Level.Foreground, FallbackValue=Black}">
                                      <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" Opacity="0.85" Margin="0,0,0,3"
                                                   IsVisible="{Binding $parent[UserControl].((vm:ReportsViewModel)DataContext).Image.ShowAbbreviations, FallbackValue=False}"
                                                   Text="{Binding Level.Abbrev, StringFormat='[{0}]', FallbackValue=''}" />
                                        <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlaybackItem">
                                              <DockPanel Height="24">
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="15" Text="{Binding Amount}">
                                                  <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                      <Binding Path="HasAmount" />
                                                      <Binding Path="$parent[UserControl].((vm:ReportsViewModel)DataContext).Image.ShowAmounts" FallbackValue="False" />
                                                    </MultiBinding>
                                                  </TextBlock.IsVisible>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title, StringFormat='• {0}'}" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource CondensedFontFamily}" FontSize="15" />
                                              </DockPanel>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </DockPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <DockPanel Margin="0,4,0,0" IsVisible="{Binding ShowLevelLabels}">
                        <Border DockPanel.Dock="Left" Width="150" />
                        <Border BorderBrush="#5E6A75" BorderThickness="0,1,0,0" Margin="3,0,0,0" Padding="0,8,0,0">
                          <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:LevelChip">
                                <Border Background="{Binding Background}" CornerRadius="3" Padding="9,4" Margin="2.5,0" HorizontalAlignment="Left">
                                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </DockPanel>
                    </StackPanel>
                    <!-- Eje X: centrado bajo las celdas (corrido por el ancho de los rótulos de fila, si se muestran) -->
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" IsVisible="{Binding ShowAxisNames}">
                      <Border DockPanel.Dock="Left" Width="153" IsVisible="{Binding ShowLevelLabels}" />
                      <TextBlock FontSize="17" Foreground="#5E6A75" HorizontalAlignment="Center" Text="{x:Static r:Strings.Matrix_AxisProbability}" />
                    </DockPanel>
                  </Grid>
                </DockPanel>
              </Border>
            </ThemeVariantScope>
          </Viewbox>
        </Border>
      </DockPanel>
    </TabItem>

    <!-- RF-17: Ficha detallada por riesgo -->
    <TabItem Header="{x:Static r:Strings.Reports_Detail}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button ui:ButtonIcon.Icon="{StaticResource IconPdf}" Content="{x:Static r:Strings.Reports_ExportDetailPdf}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}" CommandParameter="PdfDetail" />
        </StackPanel>
        <Grid ColumnDefinitions="300,12,*">
          <Border Classes="card" Padding="0">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportItem">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" Background="{Binding RiskLevel.Background}" CornerRadius="2" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <ScrollViewer>
              <StackPanel Spacing="12" DataContext="{Binding Selected}" x:DataType="vm:ReportItem">
                <TextBlock Classes="h1" TextWrapping="Wrap" Text="{Binding Heading}" />
                <TextBlock Classes="muted">
                  <Run Text="{x:Static r:Strings.Project_Name}" /><Run Text=": " />
                  <Run Text="{Binding $parent[UserControl].((vm:ReportsViewModel)DataContext).ProjectName, Mode=OneWay}" />
                  <Run Text="   " />
                  <Run Text="{x:Static r:Strings.Project_Company}" /><Run Text=": " />
                  <Run Text="{Binding $parent[UserControl].((vm:ReportsViewModel)DataContext).CompanyName, Mode=OneWay}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Dimensions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailDimension">
                      <Grid ColumnDefinitions="240,140,*" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <ContentControl Grid.Column="1" Content="{Binding Level}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{Binding Justification}" TextWrapping="Wrap"
                                   FontStyle="{Binding HasJustification, Converter={x:Static vm:Converters.ItalicUnless}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="h2" Text="{x:Static r:Strings.Risk_Short}" />
                <views:RichTextBlock Markup="{Binding ShortDescription}" />
                <TextBlock Classes="h2" Text="{x:Static r:Strings.Risk_Long}" />
                <views:RichTextBlock Markup="{Binding LongDescription}" />
                <TextBlock Classes="h2" Text="{x:Static r:Strings.Risk_Consequences}" IsVisible="{Binding HasConsequences}" />
                <ItemsControl ItemsSource="{Binding Consequences}" IsVisible="{Binding HasConsequences}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="10,2" Margin="0,0,6,6">
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="h2" Text="{x:Static r:Strings.Risk_Materiality}" IsVisible="{Binding HasMateriality}" />
                <TextBlock Text="{Binding Materiality}" TextWrapping="Wrap" IsVisible="{Binding HasMateriality}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
