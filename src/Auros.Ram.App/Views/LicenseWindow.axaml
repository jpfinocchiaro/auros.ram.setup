<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.LicenseWindow"
        x:DataType="vm:LicenseViewModel"
        Title="{x:Static r:Strings.License_Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Classes="h2" Text="{x:Static r:Strings.License_Title}" />
    <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />

    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="{x:Static r:Strings.License_MachineCode}" />
      <DockPanel>
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static r:Strings.License_Copy}" Click="OnCopy" />
        <SelectableTextBlock Text="{Binding MachineCode}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="18"
                             FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>

    <StackPanel Spacing="10" IsVisible="{Binding !IsLicensed}">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.License_HowTo}" />
      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="{x:Static r:Strings.License_Key}" />
        <TextBox Text="{Binding Key}" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                 FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Border IsVisible="{Binding Success, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource WarningBackBrush}" CornerRadius="6" Padding="12">
      <TextBlock TextWrapping="Wrap" Text="{Binding Success}" />
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Close}" IsCancel="True" Click="OnClose" />
      <Button ui:ButtonIcon.Icon="{StaticResource IconCheck}" Classes="accent" Content="{x:Static r:Strings.License_Activate}"
              Command="{Binding ActivateCommand}" IsVisible="{Binding !IsLicensed}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
