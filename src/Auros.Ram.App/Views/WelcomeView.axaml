<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Auros.Ram.App.ViewModels"
             xmlns:r="using:Auros.Ram.App.Resources"
             x:Class="Auros.Ram.App.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="720" Margin="32,48" Spacing="24" HorizontalAlignment="Center">
      <StackPanel Spacing="6">
        <TextBlock Text="auros.ram" FontSize="34" FontWeight="Bold" />
        <TextBlock Classes="muted" FontSize="15" Text="{x:Static r:Strings.Welcome_Subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <Button Classes="accent" Margin="0,0,12,12" Padding="20,12" Command="{Binding NewCommand}">
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static r:Strings.Welcome_New}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{x:Static r:Strings.Welcome_NewHint}" FontSize="12" Opacity="0.85" />
          </StackPanel>
        </Button>
        <Button Margin="0,0,12,12" Padding="20,12" Command="{Binding OpenCommand}">
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static r:Strings.Welcome_Open}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{x:Static r:Strings.Welcome_OpenHint}" FontSize="12" Opacity="0.85" />
          </StackPanel>
        </Button>
        <Button Margin="0,0,12,12" Padding="20,12" Command="{Binding ImportJsonCommand}">
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static r:Strings.Welcome_Import}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{x:Static r:Strings.Welcome_ImportHint}" FontSize="12" Opacity="0.85" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <Border Classes="card" IsVisible="{Binding HasRecent}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{x:Static r:Strings.Welcome_Recent}" />
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentItem">
                <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource WarningBackBrush}" CornerRadius="6" Padding="14">
        <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Welcome_SecurityNote}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
