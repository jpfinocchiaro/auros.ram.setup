<Window xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:Auros.Ram.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.ExportConfirmWindow"
        x:DataType="vm:ExportConfirmViewModel"
        Title="{x:Static r:Strings.Export_WarningTitle}"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <!-- RNF-38: las exportaciones salen en claro; se advierte y se ofrece proteger el PDF. -->
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="h2" Text="{x:Static r:Strings.Export_WarningTitle}" />
    <Border Background="{DynamicResource WarningBackBrush}" CornerRadius="6" Padding="12">
      <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Export_WarningText}" />
    </Border>
    <StackPanel IsVisible="{Binding IsPdf}" Spacing="8">
      <CheckBox IsChecked="{Binding ProtectPdf}" Content="{x:Static r:Strings.Export_ProtectPdf}" />
      <StackPanel IsVisible="{Binding ProtectPdf}" Spacing="8">
        <TextBox PasswordChar="•" Text="{Binding Password}" Watermark="{x:Static r:Strings.Export_PdfPassword}" />
        <TextBox PasswordChar="•" Text="{Binding Confirmation}" Watermark="{x:Static r:Strings.Password_Confirm}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button ui:ButtonIcon.Icon="{StaticResource IconClose}" Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button ui:ButtonIcon.Icon="{StaticResource IconExport}" Classes="accent" Content="{x:Static r:Strings.Export_Continue}" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
