<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auros.Ram.App.ViewModels"
        xmlns:r="using:Auros.Ram.App.Resources"
        x:Class="Auros.Ram.App.Views.NewMatrixWindow"
        x:DataType="vm:NewMatrixViewModel"
        Title="{x:Static r:Strings.New_Title}"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="h2" Text="{x:Static r:Strings.New_Title}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.New_Intro}" />
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Project_Name}" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="200" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" Text="{x:Static r:Strings.Project_Company}" />
      <TextBox Text="{Binding Company}" MaxLength="200" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="{x:Static r:Strings.New_Scales}" />
      <!-- Tamaños con la miniatura de su mapa de calor; el elegido se marca como botón activo. -->
      <ItemsControl ItemsSource="{Binding SizeOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MatrixSizeOption">
            <RadioButton GroupName="scales" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSelected}"
                         Padding="10,10,10,6" ToolTip.Tip="{Binding Label}">
              <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding Cells}" Width="64" Height="64">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="{Binding Size}" Columns="{Binding Size}" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="IBrush">
                      <Border Background="{Binding}" Margin="0.5" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static r:Strings.New_SizeHint}" />
      <RadioButton GroupName="scales" IsChecked="{Binding UseTemplate}" Content="{x:Static r:Strings.New_TemplateScales}" Margin="0,4,0,0" />
    </StackPanel>
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="{x:Static r:Strings.Common_Continue}" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
