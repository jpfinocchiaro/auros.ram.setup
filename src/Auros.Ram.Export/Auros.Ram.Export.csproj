  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auros.Ram.Core\Auros.Ram.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ExportText.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)ExportText.Designer.cs</StronglyTypedFileName>
